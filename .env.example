APP_NAME="Interior ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=interior_erp
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@interior-erp.test"
MAIL_FROM_NAME="${APP_NAME}"

# S3-compatible storage — leave blank while FILESYSTEM_DISK=local (see §72 of ARCHITECTURE.md)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Automated backups (spatie/laravel-backup — see BACKUP.md). Leave
# BACKUP_ARCHIVE_PASSWORD blank for an unencrypted archive; set it to
# encrypt the zip spatie/laravel-backup produces. BACKUP_NOTIFICATION_EMAIL
# is who gets emailed if a scheduled backup fails or goes stale.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

VITE_APP_NAME="${APP_NAME}"

# Document upload limits (FileService reads these)
UPLOAD_MAX_SIZE_KB=20480
UPLOAD_ALLOWED_MIMES="pdf,jpg,jpeg,png,doc,docx,xls,xlsx,zip,dwg,skp"
